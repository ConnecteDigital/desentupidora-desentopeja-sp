---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButtons from '../../components/CtaButtons.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { site } from '../../data/site';
import { servicos } from '../../data/servicos';
import { breadcrumbSchema } from '../../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
];
---

<Base
  title="Serviços de Desentupidora 24h em SP e ABC | Desentope Já"
  description="Todos os serviços da Desentope Já: desentupimento de pia, vaso sanitário, ralo, esgoto e hidrojateamento. 24 horas em SP e ABC."
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Serviços</span>
      <h1>Serviços de desentupidora</h1>
      <p class="hero-lead">Desentupimento 24 horas em {site.regioes}.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
